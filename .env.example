# ==========================================
# BANCO DE DADOS
# ==========================================
DATABASE_URL="postgresql://adtrack:adtrack_dev_password@localhost:5432/adtrack?schema=public"

# ==========================================
# REDIS (cache + filas BullMQ)
# ==========================================
REDIS_URL="redis://localhost:6379"

# ==========================================
# AUTH (Etapa 3)
# ==========================================
JWT_SECRET="troque-por-um-segredo-forte-em-producao"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""

# Chave usada para criptografar tokens de terceiros (Ad Accounts, Checkouts) no banco
TOKEN_ENCRYPTION_KEY="gere-com-openssl-rand-hex-32"

# ==========================================
# INTEGRAÇÕES DE ANÚNCIO (Etapa 4+)
# ==========================================
META_APP_ID=""
META_APP_SECRET=""
GOOGLE_ADS_CLIENT_ID=""
GOOGLE_ADS_CLIENT_SECRET=""
GOOGLE_ADS_DEVELOPER_TOKEN=""
TIKTOK_APP_ID=""
TIKTOK_APP_SECRET=""

# ==========================================
# BILLING (Etapa 8)
# ==========================================
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ==========================================
# APP
# ==========================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
API_URL="http://localhost:3333"
NODE_ENV="development"
